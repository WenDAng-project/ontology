                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q1400264"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q215627"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Indicates the artist and / or the artistic collective whose tag is represented in the Calli-Writing unit.</rdfs:comment>
        <rdfs:label>is tag of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#isUnitOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#isUnitOf">
        <rdfs:domain rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/write/ontology#WriteCollections"/>
        <rdfs:comment>Links the Calli-Writing unit to the artwork it derives from.</rdfs:comment>
        <rdfs:label>is unit of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#madeUsingTool -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#madeUsingTool">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#CalliWritingUnit"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#WriteCollections"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Tool used in the creation of the artwork / Calli-Writing unit (e.g. brush, pencil, spray can, hand, hair).</rdfs:comment>
        <rdfs:label>made using tool</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#relatedUnit -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#relatedUnit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:range rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:comment>Indicates other &quot;Calli-Writing&quot; unit belonging to the same artwork.</rdfs:comment>
        <rdfs:label>related unit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#usesArtwork -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#usesArtwork">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q184485"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4502142"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4502142"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#TraditionalArtwork"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>An already-existing artwork incorporated into a performing arts event or used in the creation of another artwork (n.b.: for new artworks produced during a performing arts event, use &apos;creates artwork&apos;).</rdfs:comment>
        <rdfs:label>uses artwork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.wikidata.org/prop/direct/P1476 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P1476">
        <rdfs:comment>Published name of a work, such as a newspaper article, a literary work, piece of music, a website, or a performance work.</rdfs:comment>
        <rdfs:label>title</rdfs:label>
        <skos:scopeNote>Title of the artwork, literary work, exhibition, or series of creative works (n.b.: multiple values are possible, each accompanied by a language tag).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P2047 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P2047">
        <rdfs:comment>Length of time of an event or process.</rdfs:comment>
        <rdfs:label>duration</rdfs:label>
        <skos:scopeNote>Duration of the performing arts event.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P2048 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P2048">
        <rdfs:comment>Vertical length of an entity.</rdfs:comment>
        <rdfs:label>height</rdfs:label>
        <skos:scopeNote>Height of the artwork.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P2049 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P2049">
        <rdfs:comment>Width of an object.</rdfs:comment>
        <rdfs:label>width</rdfs:label>
        <skos:scopeNote>Width of the artwork.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P2284 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P2284">
        <rdfs:comment>Published price listed or paid for a product (use with unit of currency).</rdfs:comment>
        <rdfs:label>price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P2561 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P2561">
        <rdfs:comment>Name the subject is known by.</rdfs:comment>
        <rdfs:label>name</rdfs:label>
        <skos:scopeNote>Name of the person, artistic collective, or organisation (can be accompanied with the language tags).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P569 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P569">
        <rdfs:comment>Date on which the subject was born.</rdfs:comment>
        <rdfs:label>date of birth</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P570 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P570">
        <rdfs:comment>Date on which the subject died.</rdfs:comment>
        <rdfs:label>date of death</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P571 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P571">
        <rdfs:comment>Time when an entity begins to exist.</rdfs:comment>
        <rdfs:label>date of creation</rdfs:label>
        <skos:scopeNote>Date when the artwork, the literary work, the artistic collective or the organisation was created (n.b.: for performing arts, use &apos;date&apos;).</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P580 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P580">
        <rdfs:comment>Time an entity begins to exist or a statement starts being valid.</rdfs:comment>
        <rdfs:label>start time</rdfs:label>
        <skos:scopeNote>Date when the event started.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P582 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P582">
        <rdfs:comment>Moment when an entity ceases to exist and a statement stops being entirely valid or no longer be true.</rdfs:comment>
        <rdfs:label>end time</rdfs:label>
        <skos:scopeNote>Date when the event finished.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P585 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P585">
        <rdfs:comment>Date something took place, existed or a statement was true.</rdfs:comment>
        <rdfs:label>date</rdfs:label>
        <skos:scopeNote>Date in which a performing arts event occurred.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P6375 -->

    <owl:DatatypeProperty rdf:about="http://www.wikidata.org/prop/direct/P6375">
        <rdfs:comment>Full street address where subject is located.</rdfs:comment>
