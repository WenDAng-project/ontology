        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Indicates the type of calligraphic education the person has (allowed values: &apos;familial&apos;, &apos;self-Taught&apos;, &apos;master-taught&apos;, &apos;academic&apos;, &apos;school&apos;, &apos;not present&apos;, &apos;present (not specified)&apos;).</rdfs:comment>
        <rdfs:label>has calligraphic training</rdfs:label>
    </owl:DatatypeProperty>
    


