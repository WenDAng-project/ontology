        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Notes of any kind related to the item (private use only).</rdfs:comment>
        <rdfs:label>notes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/write/ontology#numberOfCharacters -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#numberOfCharacters">
