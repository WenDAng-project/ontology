        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates the presence or absence of a calligraphic line within a Calli-Writing unit.</rdfs:comment>
        <rdfs:label>has calligraphic line</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/write/ontology#hasCalligraphicTraining -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#hasCalligraphicTraining">
