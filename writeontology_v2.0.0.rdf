    <!-- http://www.w3.org/2004/02/skos/core#Concept -->

    <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
    


    <!-- http://www.wikidata.org/entity/Q1400264 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q1400264">
        <rdfs:comment>Group of artists who create works together.</rdfs:comment>
        <rdfs:label>Artistic Collective</rdfs:label>
        <skos:scopeNote>Group of artists from diverse disciplines (e.g., calligraphers, graffiti writers, dancers, etc.) collaborating to create collective artistic works of any kind.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q17514 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q17514">
        <rdfs:subClassOf rdf:resource="https://w3id.org/write/ontology#WriteCollections"/>
        <rdfs:comment>Genre of writing or drawing etched, scratched, scribbled, or sprayed (often, but not always illicitly) on a wall or other surface in a public place.</rdfs:comment>
        <rdfs:label>Graffiti</rdfs:label>
        <skos:scopeNote>Includes artworks from the WRITE collection specifically categorised under Graffiti Art.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q184485 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q184485">
        <rdfs:subClassOf rdf:resource="https://w3id.org/write/ontology#WriteCollections"/>
        <rdfs:comment>Art form that is performed for an audience.</rdfs:comment>
        <rdfs:label>Performing Arts</rdfs:label>
        <skos:scopeNote>A class that includes artworks from the WRITE collection specifically categorised under Performing Arts, including performance events.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q215627 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q215627">
        <rdfs:comment>Being that has certain capacities or attributes constituting personhood.</rdfs:comment>
        <rdfs:label>Person</rdfs:label>
        <skos:scopeNote>Individuals who engage in creative, artistic, or organisational roles (such as calligraphers, musicians, dancers, singers, graffiti writers, authors, creators, organisers, curators, and others).</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q43229 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q43229">
        <rdfs:comment>Social entity established to meet needs or pursue goals.</rdfs:comment>
        <rdfs:label>Organisation</rdfs:label>
        <skos:scopeNote>Organisation involved in the production / commissioning of an artwork or the organisation of an exhibition.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q4502142 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q4502142">
        <rdfs:subClassOf rdf:resource="https://w3id.org/write/ontology#WriteCollections"/>
        <rdfs:comment>Work of art that is primarily visual.</rdfs:comment>
        <rdfs:label>Visual Arts</rdfs:label>
        <skos:scopeNote>Includes artworks from the WRITE collection specifically categorised under Visual Arts.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q464980 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q464980">
        <rdfs:comment>Organized presentation and display of a selection of items or pictures.</rdfs:comment>
        <rdfs:label>Exhibition</rdfs:label>
        <skos:scopeNote>Exhibition showcasing one or more artworks (or artworks&apos; series) from the four WRITE collections.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q7725310 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q7725310">
        <rdfs:comment>Ordered set of creative works.</rdfs:comment>
        <rdfs:label>Series of Creative Works</rdfs:label>
        <skos:scopeNote>A set of related artworks that might be included in the four WRITE collections.</skos:scopeNote>
    </owl:Class>
    


    <!-- http://www.wikidata.org/entity/Q7725634 -->

    <owl:Class rdf:about="http://www.wikidata.org/entity/Q7725634">
        <rdfs:comment>Written work read for enjoyment or edification.</rdfs:comment>
        <rdfs:label>Literary Work</rdfs:label>
        <skos:scopeNote>Literary work (in whole or in part) that serves as the basis or inspiration for a Calli-Writing unit, or the creation of an artwork.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/write/ontology#CalliWritingUnit -->

    <owl:Class rdf:about="https://w3id.org/write/ontology#CalliWritingUnit">
        <rdfs:comment>In an artwork, a content unit featuring elements of calligraphy and / or writing, in a form of meaningful writing, set of signs and / or set of lines.</rdfs:comment>
        <rdfs:label>Calli-Writing Unit</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/write/ontology#DecorativeAndAppliedArts -->

    <owl:Class rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts">
        <rdfs:subClassOf rdf:resource="https://w3id.org/write/ontology#WriteCollections"/>
        <rdfs:comment>Includes artworks from the WRITE collection specifically categorised under Decorative and Applied Arts.</rdfs:comment>
        <rdfs:label>Decorative and Applied Arts</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/write/ontology#TraditionalArtwork -->

    <owl:Class rdf:about="https://w3id.org/write/ontology#TraditionalArtwork">
        <rdfs:comment>Artwork that follows traditional calligraphic canons and / or is created before 1980. This artwork does not belong to any of the four WRITE collections, but it is somehow related to one or more artworks from these collections.</rdfs:comment>
        <rdfs:label>Traditional Artwork</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/write/ontology#WriteCollections -->

    <owl:Class rdf:about="https://w3id.org/write/ontology#WriteCollections">
        <rdfs:comment>Superclass that encompasses artworks from four distinct types of art (Visual Arts, Performing Arts, Graffiti Art, and Decorative and Applied Arts). There are four WRITE collections, one for each art category.</rdfs:comment>
        <rdfs:label>WRITE collections</rdfs:label>
    </owl:Class>
</rdf:RDF>



