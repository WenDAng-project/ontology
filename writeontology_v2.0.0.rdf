        <rdfs:label>has big characters calligraphy</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/write/ontology#hasCalligraphicLine -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#hasCalligraphicLine">
