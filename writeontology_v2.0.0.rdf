                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q215627"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.wikidata.org/entity/Q184485"/>
        <rdfs:comment>Indicates the performing arts event in which the person or artistic collective took part as a performer.</rdfs:comment>
        <rdfs:label>is performer of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#isTagOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#isTagOf">
        <rdfs:domain rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:range>
