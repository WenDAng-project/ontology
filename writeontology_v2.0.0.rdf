    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#transcriptionAndTranslation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q7725634"/>
