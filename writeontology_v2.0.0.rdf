            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates the presence or absence of a seal, typically square-shaped and red-coloured, which serves as the signature of the artist.</rdfs:comment>
        <rdfs:label>has seal</rdfs:label>
    </owl:DatatypeProperty>
    


