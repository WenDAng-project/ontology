    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/subject -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/subject"/>
    


    <!-- http://purl.org/dc/terms/version -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/version"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#scopeNote -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#scopeNote"/>
    


    <!-- https://w3id.org/write/ontology#accuracy -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/write/ontology#accuracy">
        <rdfs:comment>Indicates that a value is approximate or uncertain.</rdfs:comment>
        <rdfs:label>accuracy</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.wikidata.org/prop/direct/P103 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P103">
        <rdfs:comment>Language or languages a person has learned from early childhood.</rdfs:comment>
        <rdfs:label>native language</rdfs:label>
        <skos:scopeNote>Native language of the person. For other languages that the person speaks, writes or signs, use &apos;uses language&apos;.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P106 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P106">
        <rdfs:comment>Occupation of the person.</rdfs:comment>
        <rdfs:label>occupation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P10661 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P10661">
        <rdfs:comment>Intellectual or creative entity (person or organisation) responsible for the elements exhibited.</rdfs:comment>
        <rdfs:label>exhibited artist</rdfs:label>
        <skos:scopeNote>Artist(s) whose artworks are displayed in the exhibition.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P1071 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P1071">
        <rdfs:comment>Place where the item was conceived or made.</rdfs:comment>
        <rdfs:label>location of creation</rdfs:label>
        <skos:scopeNote>Indicates the city or country where a specific artwork or artworks&apos; series were created.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P127 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P127">
        <rdfs:comment>Owner of the subject.</rdfs:comment>
        <rdfs:label>owner</rdfs:label>
        <skos:scopeNote>Person, artistic collective or organisation who is the proprietor of the artwork.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P1303 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P1303">
        <rdfs:comment>Musical instrument that a person plays or teaches or used in a music occupation.</rdfs:comment>
        <rdfs:label>musical instrument</rdfs:label>
        <skos:scopeNote>Musical instrument used during a performing arts event.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P1412 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P1412">
        <rdfs:comment>Language(s) that a person or a people speaks, writes or signs, including the native language(s).</rdfs:comment>
        <rdfs:label>uses language</rdfs:label>
        <skos:scopeNote>Languages other than native, that the person speaks, writes or signs.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P144 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P144">
        <rdfs:comment>The work(s) or inputs used as the basis for subject item.</rdfs:comment>
        <rdfs:label>based on</rdfs:label>
        <skos:scopeNote>Literary work on which the Calli-Writing unit is based.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P1640 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P1640">
        <rdfs:comment>Content specialist responsible for the collection or exhibition.</rdfs:comment>
        <rdfs:label>curator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P170 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P170">
        <rdfs:comment>Maker of the creative work or other object.</rdfs:comment>
        <rdfs:label>creator</rdfs:label>
        <skos:scopeNote>Person or artistic collective that created the visual or graffiti artwork, an artwork series, or a traditional artwork.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P175 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P175">
        <rdfs:comment>Actor, musician, band or other performer associated with this role or musical work.</rdfs:comment>
        <rdfs:label>performer</rdfs:label>
        <skos:scopeNote>Person or artistic collective that took part in a performing arts event as a performer, including roles such as dancer, musician, singer, or actor.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P176 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P176">
        <rdfs:comment>Manufacturer or producer of the product.</rdfs:comment>
        <rdfs:label>manufacturer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P179 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P179">
        <rdfs:comment>Series which contains the subject.</rdfs:comment>
        <rdfs:label>is part of series</rdfs:label>
        <skos:scopeNote>Connects the artwork to the series it belongs to.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P180 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P180">
        <rdfs:comment>Entity visually depicted in an image, literarily described in a work, or otherwise incorporated into an audiovisual or other medium.</rdfs:comment>
        <rdfs:label>depicts</rdfs:label>
        <skos:scopeNote>Relates an artwork or a &quot;Calli-Writing&quot; unit to a concrete, thematic, conceptual, formal, aesthetic, or procedural element that contributes to its content or interpretation.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P186 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P186">
        <rdfs:comment>Material the subject or the object is made of or derived from.</rdfs:comment>
        <rdfs:label>made from material</rdfs:label>
        <skos:scopeNote>Material used in the creation of the artwork / Calli-Writing unit, applied to a support (e.g. ink, paper).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P19 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P19">
        <rdfs:comment>Most specific known birth location of a person.</rdfs:comment>
        <rdfs:label>place of birth</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P20 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P20">
        <rdfs:comment>Most specific known death location of a person.</rdfs:comment>
        <rdfs:label>place of death</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P21 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P21">
        <rdfs:comment>Gender identity of the person.</rdfs:comment>
        <rdfs:label>gender</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P27 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P27">
        <rdfs:comment>Country of citizenship of the person.</rdfs:comment>
        <rdfs:label>country of citizenship</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P276 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P276">
        <rdfs:comment>Location of the object, structure or event.</rdfs:comment>
        <rdfs:label>location</rdfs:label>
        <skos:scopeNote>Indicates a specific geographical location (such as a building, city, or country) where an event took place, an artwork is located, or an organisation / artistic collective is based.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P282 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P282">
        <rdfs:comment>Alphabet, character set or other system of writing used by a language, word, or text, supported by a typeface.</rdfs:comment>
        <rdfs:label>writing system</rdfs:label>
        <skos:scopeNote>Characters, alphabet or other system of writing used in a Calli-Writing unit, including the non-traditional writing systems such as Dunhuang Musical score.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P287 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P287">
        <rdfs:comment>Person or organisation which designed the object. For buildings use &apos;architect&apos;.</rdfs:comment>
        <rdfs:label>designer</rdfs:label>
        <skos:scopeNote>Person or artistic collective responsible for designing a piece of decorative and applied art.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P407 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P407">
        <rdfs:comment>Language associated with this creative work (such as books, shows, songs, broadcasts or websites) or a name.</rdfs:comment>
        <rdfs:label>language</rdfs:label>
        <skos:scopeNote>Language associated with the Calli-Writing unit.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P462 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P462">
        <rdfs:comment>Colour of subject.</rdfs:comment>
        <rdfs:label>has colour</rdfs:label>
        <skos:scopeNote>Colour used in the making of an artwork or a Calli-Writing unit (for the latter, distinct from &apos;background colour&apos;).</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P463 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P463">
        <rdfs:comment>Organisation, club or musical group to which the subject belongs.</rdfs:comment>
        <rdfs:label>is member of</rdfs:label>
        <skos:scopeNote>An artistic collective or organisation a person belongs to.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P50 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P50">
        <rdfs:comment>Main creator of a written work.</rdfs:comment>
        <rdfs:label>author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P608 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P608">
        <rdfs:comment>Exhibition(s) where the artwork is or was displayed.</rdfs:comment>
        <rdfs:label>exhibition history</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P664 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P664">
        <rdfs:comment>Person or organisation responsible for organising an event.</rdfs:comment>
        <rdfs:label>organiser</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P812 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P812">
        <rdfs:comment>Major someone studied at college/university.</rdfs:comment>
        <rdfs:label>field of study</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P84 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P84">
        <rdfs:comment>Person or architectural firm responsible for designing the building.</rdfs:comment>
        <rdfs:label>architect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P856 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P856">
        <rdfs:comment>URL of the official page of an item.</rdfs:comment>
        <rdfs:label>official website</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P86 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P86">
        <rdfs:comment>Person(s) who wrote the music.</rdfs:comment>
        <rdfs:label>composer</rdfs:label>
        <skos:scopeNote>Person who composed the music for the performing arts event.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P88 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P88">
        <rdfs:comment>Person or organisation that commissioned the work.</rdfs:comment>
        <rdfs:label>commissioner</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P9302 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P9302">
        <rdfs:comment>Style of script of a document or typeface.</rdfs:comment>
        <rdfs:label>script style</rdfs:label>
        <skos:scopeNote>Indicates a specific form / style of the Chinese script used in a Calli-Writing unit.</skos:scopeNote>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P937 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P937">
        <rdfs:comment>Location where persons are actively participating in employment, business or other work.</rdfs:comment>
        <rdfs:label>place of activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P941 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P941">
        <rdfs:comment>Work, human, place or event which inspired this creative work or fictional entity.</rdfs:comment>
        <rdfs:label>inspired by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.wikidata.org/prop/direct/P973 -->

    <owl:ObjectProperty rdf:about="http://www.wikidata.org/prop/direct/P973">
        <rdfs:comment>Item is described at the following URL.</rdfs:comment>
        <rdfs:label>described at URL</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#calligrapher -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#calligrapher">
        <owl:inverseOf rdf:resource="https://w3id.org/write/ontology#isCalligrapherOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q184485"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q1400264"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q215627"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Indicates the calligrapher who took part in a performing arts event or who produced the calligraphy for a decorative and applied artwork.</rdfs:comment>
        <rdfs:label>calligrapher</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#createsArtwork -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#createsArtwork">
        <owl:inverseOf rdf:resource="https://w3id.org/write/ontology#derivesFrom"/>
        <rdfs:domain rdf:resource="http://www.wikidata.org/entity/Q184485"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4502142"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/write/ontology#usesArtwork"/>
        <rdfs:comment>Indicates the artwork created during a performing arts event.</rdfs:comment>
        <rdfs:label>creates artwork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#derivesFrom -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#derivesFrom">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4502142"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.wikidata.org/entity/Q184485"/>
        <rdfs:comment>Indicates the performing arts event from which the visual or decorative artwork derives from.</rdfs:comment>
        <rdfs:label>derives from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#exhibitedArtwork -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#exhibitedArtwork">
        <rdfs:domain rdf:resource="http://www.wikidata.org/entity/Q464980"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q184485"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q4502142"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q7725310"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>Artwork(s) displayed in the exhibition (including those represented within the artworks&apos; series).</rdfs:comment>
        <rdfs:label>exhibited artwork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#hasArtisticCollectiveType -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#hasArtisticCollectiveType">
        <rdfs:domain rdf:resource="http://www.wikidata.org/entity/Q1400264"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Indicates the type of the artistic collective (e.g., graffiti crew, dance company, architectural firm, etc.).</rdfs:comment>
        <rdfs:label>has artistic collective type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#hasBackgroundColour -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#hasBackgroundColour">
        <rdfs:domain rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Background colour of the Calli-Writing Unit.</rdfs:comment>
        <rdfs:label>has background colour</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#hasCharacterForm -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#hasCharacterForm">
        <rdfs:domain rdf:resource="https://w3id.org/write/ontology#CalliWritingUnit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Form of the Chinese character present in a Calli-Writing unit, i.e. simplified or non simplified Chinese character.</rdfs:comment>
        <rdfs:label>has character form</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#hasChineseConcept -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#hasChineseConcept">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q17514"/>
                    <rdf:Description rdf:about="http://www.wikidata.org/entity/Q184485"/>
                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment>Philosophical, literary, cultural, social or other concept or notion represented within the artwork.</rdfs:comment>
        <rdfs:label>has Chinese concept</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/write/ontology#hasChineseVisualElement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/write/ontology#hasChineseVisualElement">
