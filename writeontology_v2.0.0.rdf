        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment>Signature of the graffiti writer (n.b.: multiple values are possible, each accompanied by a language tag).</rdfs:comment>
        <rdfs:label>has tag</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/write/ontology#notes -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#notes">
