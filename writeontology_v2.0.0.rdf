                    <rdf:Description rdf:about="https://w3id.org/write/ontology#DecorativeAndAppliedArts"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:propertyDisjointWith rdf:resource="https://w3id.org/write/ontology#hasOtherVisualElement"/>
        <rdfs:comment>Visual element or motif derived from Chinese culture that appears in the artwork.</rdfs:comment>
