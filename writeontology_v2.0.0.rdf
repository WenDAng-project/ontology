                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment>Indicates the presence or absence of a colophon, which typically includes the time or date when the artwork was completed, the name of the artist, and the location.</rdfs:comment>
        <rdfs:label>has colophon</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/write/ontology#hasSeal -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/write/ontology#hasSeal">
