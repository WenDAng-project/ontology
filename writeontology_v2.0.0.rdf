<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/write/ontology#"
     xml:base="https://w3id.org/write/ontology"
     xmlns:wd="http://www.wikidata.org/entity/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wdt="http://www.wikidata.org/prop/direct/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:write="https://w3id.org/write/ontology#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/write/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/write/ontology#v2.0.0"/>
        <dcterms:contributor>Adriana Iezzi (domain expert)
Martina Merenda (domain expert)
Daniele Caccin (domain expert)
Marta R. Bisceglia (domain expert)
Valentina Pasqual (former contributor on the core draft v0.1.0)</dcterms:contributor>
        <dcterms:creator>Katarina Lučić</dcterms:creator>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-28</dcterms:modified>
        <dcterms:subject>&quot;Chinese calligraphy&quot;, &quot;contemporary calligraphy&quot;, &quot;contemporary arts&quot;, &quot;visual arts&quot;, &quot;graffiti&quot;, &quot;performing art&quot;, &quot;decorative and applied arts&quot;</dcterms:subject>
        <dcterms:version>2.0.0</dcterms:version>
        <rdfs:comment xml:lang="en">The WRITE ontology provides a semantic model for contemporary Chinese calligraphy and its intersections with visual, performing, graffiti, and decorative and applied arts. It describes artworks, their calligraphic and writing-like components, literary works, people in different roles, exhibitions, artwork series, and other contextual elements, supporting their structured representation and analysis within the WRITE knowledge graph.</rdfs:comment>
        <rdfs:comment xml:lang="en">This ontology was developed in collaboration with the domain experts, all of whom are members of the WRITE project team. To learn more about the project, please visit: https://writecalligraphyproject.eu/.</rdfs:comment>
        <rdfs:label>WRITE ontology</rdfs:label>
    </owl:Ontology>
    


